rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, displayName, photoURL, createdAt
    //
    // Collection: chats/{chatId}/messages
    // Fields: uid, text, role, timestamp, groundingMetadata
    //
    // Collection: design_projects
    // Fields: uid, prompt, imageUrl, type, metadata, createdAt
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "biggiesmason@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['uid', 'text', 'role', 'timestamp']) &&
             data.uid is string &&
             data.text is string &&
             data.text.size() < 5000 &&
             data.role in ['user', 'model'];
    }

    function isValidProject(data) {
      return data.keys().hasAll(['uid', 'imageUrl', 'type', 'createdAt']) &&
             data.uid is string &&
             data.imageUrl is string &&
             data.type in ['generation', 'analysis', 'edit'];
    }

    // Rules
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && isValidUser(request.resource.data);
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && isValidMessage(request.resource.data);
    }

    match /design_projects/{projectId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && isValidProject(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }
  }
}
