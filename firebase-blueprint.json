{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the authenticated user",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message in a chat conversation",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Author UID" },
        "text": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "groundingMetadata": { "type": "object", "description": "Optional search/maps grounding info" }
      },
      "required": ["uid", "text", "role", "timestamp"]
    },
    "DesignProject": {
      "title": "Design Project",
      "description": "A project in the Engineering Design Lab",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "prompt": { "type": "string" },
        "imageUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["generation", "analysis", "edit"] },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "imageUrl", "type", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages within a chat session"
    },
    "/design_projects/{projectId}": {
      "schema": "DesignProject",
      "description": "Engineering design projects and AI generations"
    }
  }
}
